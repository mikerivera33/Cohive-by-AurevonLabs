{
  "name": "cohive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cohive by AurevonLabs \u2014 trips, homes and dinners in one shared hive.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild src/engine/engine.ts --bundle --platform=node --format=esm --outfile=server/engine-bundle.mjs --log-level=error",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:engine": "esbuild scripts/verify-engine.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-engine.mjs --log-level=error && node node_modules/.cache/verify-engine.mjs",
    "verify:api": "npm run build:server && node scripts/verify-api.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "stress:engine": "esbuild scripts/stress-engine.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stress-engine.mjs --log-level=error && node node_modules/.cache/stress-engine.mjs",
    "stress": "node scripts/stress-browser.mjs",
    "a11y": "node scripts/a11y.mjs",
    "api": "npm run build:server && node server.mjs",
    "start": "npm run build:server && node server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "tar": "^7.5.21",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
