# Cohive API — copy to .env (never commit secrets)
# Postgres: durable, multi-instance safe. Unset → memory + JSON file (dev only).
DATABASE_URL=postgres://cohive:cohive@127.0.0.1:5432/cohive
# Where email links and invite links point.
COHIVE_PUBLIC_URL=http://127.0.0.1:8080
# Magic-link mail (Resend). Unset outside production → the API returns a devLink instead.
RESEND_API_KEY=
COHIVE_MAIL_FROM="Cohive <hello@cohive.app>"
# OAuth (optional until keys exist; the gateway falls back to demo sessions).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Either a pre-minted client secret, or the Sign in with Apple key and the server mints it (ES256, renewed daily).
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Demo sign-in (unproven sessions) is off in production; set to 1 only for a throwaway preview.
COHIVE_ALLOW_DEMO=
# Billing webhook: adapters (RevenueCat / Stripe / App Store) post normalised events signed
# with HMAC-SHA256 of the raw body in X-Cohive-Signature.
COHIVE_BILLING_SECRET=
# Lock CORS to the web origin in production (enables credentialed cookies).
COHIVE_CORS_ORIGIN=*
