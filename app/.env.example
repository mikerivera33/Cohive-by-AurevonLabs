# Cohive auth / OAuth (optional)
# Without these, onboarding uses /api/auth/demo sessions.

# Public site URL used for OAuth redirect_uri construction
# COHIVE_PUBLIC_URL=https://your-site.netlify.app

# Google OAuth (authorize redirect when CLIENT_ID is set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_CLIENT_ID=

# Apple Sign In
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# VITE_APPLE_CLIENT_ID=
